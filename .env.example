# Postgres
DATABASE_URL=postgresql://paashupatastra:paashupatastra@localhost:5432/paashupatastra
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Service ports
AUTH_PORT=3001
USERS_PORT=3002
COMMUNITIES_PORT=3003
PARKING_PORT=3004
PAYMENTS_PORT=3005
NOTIFICATIONS_PORT=3006
GATEWAY_PORT=3000

# Service URLs (gateway)
AUTH_URL=http://localhost:3001
USERS_URL=http://localhost:3002
COMMUNITIES_URL=http://localhost:3003
PARKING_URL=http://localhost:3004
PAYMENTS_URL=http://localhost:3005
NOTIFICATIONS_URL=http://localhost:3006

# Public app URL (used in staff invite emails)
APP_PUBLIC_URL=http://localhost:5173

# Mail configuration
FROM_MAIL=
FROM_MAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=

# Set true only for local debugging â€” never in production
EXPOSE_DEBUG_OTP=false

# Cashfree Payment Gateway (sandbox/test)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=
GATEWAY_PUBLIC_URL=http://localhost:3000
